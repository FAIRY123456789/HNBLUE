# Copy this file to a local, untracked .env or inject the values through your
# process manager. Never commit real credentials.

DB_URL=jdbc:mysql://localhost:3306/hnblue?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=hnblue
DB_PASSWORD=
JPA_DDL_AUTO=update

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms

MODEL_API_URL=http://127.0.0.1:8880
HNBLUE_MODEL_PATH=
HNBLUE_EXTERNAL_DATA_ROOT=data/examples
HNBLUE_BAAD_FILE=data/examples/baad/BAAD_cleaned.csv

HNBLUE_LOCAL_RAG_ENABLED=true
RAG_API_URL=http://127.0.0.1:8880
HNBLUE_RAG_CHUNKS=rag/artifacts/chunks.jsonl
HNBLUE_RAG_SOURCE=rag/examples/knowledge
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=true
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# Base64-encoded 32-byte master key for encrypted administrator-managed credentials.
# Generate once with: openssl rand -base64 32
HNBLUE_SECRET_ENCRYPTION_KEY=

HNBLUE_JWT_SECRET=
HNBLUE_JWT_TTL_SECONDS=604800
HNBLUE_FIELD_ENCRYPTION_SECRET=

# Performance accounts remain blocked from public login except during a
# controlled load-test window.
HNBLUE_LOAD_TEST_LOGIN_ENABLED=false

MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8090
